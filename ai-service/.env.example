# ========================================================
# Sanjeevani AI Microservice - Environment Configuration
# ========================================================

# Service Port (Render sets this dynamically via $PORT)
PORT=8000

# Bind Host ('0.0.0.0' for cloud container/Render, '127.0.0.1' for local)
HOST=0.0.0.0

# Environment Mode ('development' enables auto-reload, 'production' for cloud)
ENV=production
