# ========================================================
# Sanjeevani Backend - Environment Configuration
# ========================================================

# Server Port (Render sets this dynamically via $PORT)
PORT=5000

# Environment Mode ('development' or 'production')
NODE_ENV=production

# MongoDB Connection String (Atlas URI in production or local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/sanjeevani?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/sanjeevani

# JWT Authentication Secret Key (Use a strong random 32+ character string in production)
JWT_SECRET=carewatch_jwt_secret_key_change_in_production
JWT_EXPIRE=7d

# Allowed Frontend Origins for CORS (comma-separated if multiple)
# In production on Render: Set to your Vercel deployment URL
# Example: https://sanjeevni.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173,https://your-sanjeevni-app.vercel.app

# Python FastAPI AI Microservice URL
# Local Development: http://127.0.0.1:8000
# Render Private Networking: http://sanjeevani-ai:8000
# Render Public Web Service: https://sanjeevani-ai.onrender.com
AI_SERVICE_URL=http://127.0.0.1:8000
