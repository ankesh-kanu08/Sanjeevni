# ========================================================
# Sanjeevani Frontend - Environment Configuration
# ========================================================

# Production Node.js Backend API URL
# Leave unset or empty for local development (Vite automatically proxies /api to http://localhost:5000)
# On Vercel: Set to your deployed Render backend URL
# Example: https://sanjeevani-backend.onrender.com/api (or https://sanjeevani-backend.onrender.com)
VITE_API_URL=https://your-sanjeevni-backend.onrender.com/api

# Production Socket.IO Server URL
# Optional: If omitted, SocketContext will automatically derive it from VITE_API_URL
# Example: https://sanjeevani-backend.onrender.com
VITE_SOCKET_URL=https://your-sanjeevni-backend.onrender.com
