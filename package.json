{
  "name": "carewatch",
  "version": "1.0.0",
  "description": "CareWatch (Sanjeevni) - AI-powered post-discharge monitoring and care-coordination platform",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:ai": "cd ai-service && python -m uvicorn app.main:app --reload --port 8000",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "seed": "npm run seed --prefix backend",
    "build:frontend": "npm run build --prefix frontend"
  },
  "keywords": ["healthcare", "monitoring", "post-discharge", "AI", "telemedicine"],
  "license": "MIT"
}
